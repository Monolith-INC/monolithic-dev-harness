__pycache__/
*.pyc
.pytest_cache/
.harness/state/
dist/
temp/

# The plugin ships these. Keep them tracked even when a global gitignore excludes hooks/ or .mcp*.
!plugins/monolithic-dev-harness/hooks/
!plugins/monolithic-dev-harness/hooks/**
!plugins/monolithic-dev-harness/.mcp.json

# Raw acceptance transcripts and archives stay local; their summaries are committed.
docs/06-delivery/acceptance/**/*.jsonl
docs/06-delivery/acceptance/**/*.tar.gz
