{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/bin/harness-python\" \"${CURSOR_PLUGIN_ROOT}/scripts/harness/hook.py\" --host cursor --event pre-tool"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/bin/harness-python\" \"${CURSOR_PLUGIN_ROOT}/scripts/harness/hook.py\" --host cursor --event shell"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/bin/harness-python\" \"${CURSOR_PLUGIN_ROOT}/scripts/harness/hook.py\" --host cursor --event mcp"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/bin/harness-python\" \"${CURSOR_PLUGIN_ROOT}/scripts/harness/hook.py\" --host cursor --event prompt"
      }
    ]
  }
}
