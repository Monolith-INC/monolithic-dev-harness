{
  "description": "monolithic-dev-harness enforcement: the harness rules plus the workflow policy runtime",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*|exec_command|functions\\.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event pre-tool",
            "timeout": 15,
            "statusMessage": "Checking harness policy"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event ask",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event answer",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|functions\\.exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event startup",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/harness-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/harness/hook.py\" --host claude --event stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
