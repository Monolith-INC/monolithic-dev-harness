{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith.inc/schemas/tracker.schema.json",
  "title": "Monolithic Dev Harness tracker manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "label", "docs", "access", "settings", "artifacts", "roles", "states", "ids", "attachments", "text_format", "writes", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "label": {"type": "string", "minLength": 1},
    "docs": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved"]},
    "access": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["mcp", "cli", "api"]}, "server": {"type": "string"}, "auth": {"type": "string"}}},
    "settings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "required"], "properties": {"key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "required": {"type": "boolean"}, "env": {"type": "string"}, "source": {"type": "string", "minLength": 1}}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "children"], "properties": {"name": {"type": "string", "minLength": 1}, "children": {"type": "array", "items": {"type": "string", "minLength": 1}}, "estimate": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}}},
    "roles": {"type": "object", "additionalProperties": false, "required": ["containers", "delivery_unit", "step"], "properties": {"containers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delivery_unit": {"type": "string", "minLength": 1}, "step": {"type": "string", "minLength": 1}}},
    "states": {"type": "object", "additionalProperties": false, "required": ["backlog", "ready", "in_progress", "done", "canceled"], "properties": {"backlog": {"type": "string", "minLength": 1}, "ready": {"type": "string", "minLength": 1}, "in_progress": {"type": "string", "minLength": 1}, "done": {"type": "string", "minLength": 1}, "canceled": {"type": "string", "minLength": 1}}},
    "ids": {"type": "object", "additionalProperties": false, "required": ["pattern", "branch_key", "mention"], "properties": {"pattern": {"type": "string", "minLength": 1}, "branch_key": {"type": "string", "minLength": 1}, "mention": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "attachments": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "text_format": {"enum": ["markdown", "html", "plain"]},
    "writes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
