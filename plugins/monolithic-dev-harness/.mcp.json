{
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${AZURE_DEVOPS_ORG}"
      ]
    },
    "backlog-orchestrator": {
      "command": "python3",
      "args": [
        "-m",
        "orchestrator_core",
        "mcp"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/runtime",
        "ORCHESTRATOR_SKILLS_DIR": "${CLAUDE_PLUGIN_ROOT}/skills"
      }
    },
    "workflow-orchestrator": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator/run_mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}",
        "ORCHESTRATOR_SKILLS_DIR": "${CLAUDE_PLUGIN_ROOT}/skills"
      }
    },
    "workflow-integrations": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/integrations/run_gateway.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
