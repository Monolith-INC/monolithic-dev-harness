{
  "schemaVersion": 1,
  "azure": {
    "organization": "",
    "project": "",
    "team": "",
    "repository": "",
    "protected_work_items": []
  },
  "backlog": {
    "artifacts_path": "docs/backlog"
  },
  "git": {
    "base_branch": "develop"
  },
  "approvals": {
    "window_minutes": 20
  },
  "checks": [
    {
      "name": "web-test",
      "run": "cd apps/web && npm test",
      "when": [
        "apps/web/**"
      ]
    },
    {
      "name": "web-lint",
      "run": "cd apps/web && npm run lint",
      "when": [
        "apps/web/**"
      ]
    },
    {
      "name": "api-test",
      "run": "cd services/api && npm test",
      "when": [
        "services/api/**"
      ]
    },
    {
      "name": "db-migrations",
      "run": "cd services/api && npm run test:migrations",
      "when": [
        "services/api/migrations/**"
      ]
    }
  ],
  "tests_required": [
    {
      "source": [
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx"
      ],
      "tests": [
        "apps/web/src/**/*.test.ts",
        "apps/web/src/**/*.test.tsx"
      ],
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/web/src/generated/**"
      ]
    },
    {
      "source": [
        "services/api/src/**/*.ts"
      ],
      "tests": [
        "services/api/src/**/*.test.ts",
        "services/api/test/**"
      ],
      "exclude": [
        "**/*.test.ts",
        "services/api/src/generated/**"
      ]
    }
  ],
  "generated": [
    "**/*.generated.ts",
    "apps/web/src/generated/**",
    "services/api/src/generated/**"
  ],
  "guarded_paths": [
    {
      "path": "services/api/migrations/**",
      "evidence": "check:db-migrations"
    },
    {
      "path": "infra/**",
      "evidence": "manual:infra-review"
    }
  ],
  "pull_requests": {
    "require_draft": true,
    "require_review_verdict": true
  }
}
