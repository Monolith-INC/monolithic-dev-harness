#!/bin/sh
# Run the harness on Python 3.12 or newer, whatever `python3` is on this machine.
# Hooks, MCP servers, and the CLI start through here. Order: $HARNESS_PYTHON, the Python the
# installer found (runtime/python-path; a host started from the desktop may not see the terminal's
# PATH), the newest versioned interpreter on the path, then python3. A recorded or versioned
# interpreter is trusted by how it was found, so the common case starts Python once.
case "$0" in */*) here="${0%/*}" ;; *) here="." ;; esac
recorded="$here/../runtime/python-path"
if [ -z "${HARNESS_PYTHON:-}" ] && [ -r "$recorded" ]; then
  read -r chosen <"$recorded" || chosen=""
  if [ -n "$chosen" ] && [ -x "$chosen" ]; then
    exec "$chosen" "$@"
  fi
fi
for candidate in python3.15 python3.14 python3.13 python3.12; do
  if [ -z "${HARNESS_PYTHON:-}" ] && command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$@"
  fi
done
for candidate in "${HARNESS_PYTHON:-}" python3; do
  [ -n "$candidate" ] || continue
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null; then
    exec "$candidate" "$@"
  fi
done
echo "monolithic-dev-harness needs Python 3.12 or newer: install it, or set HARNESS_PYTHON to its path." >&2
# Prompt and question hooks only record what the user does: never drop their message for this.
case " $* " in
*" --event prompt "* | *" --event ask "* | *" --event answer "*) exit 0 ;;
esac
exit 2
