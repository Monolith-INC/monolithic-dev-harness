#!/bin/sh
# Run the harness on Python 3.12 or newer, whatever `python3` is on this machine.
# Hooks, MCP servers, and the CLI start through here. Order: $HARNESS_PYTHON, the newest
# versioned interpreter on the path, then python3. A versioned name is trusted by its name, so
# the common case starts Python once.
for candidate in python3.15 python3.14 python3.13 python3.12; do
  if [ -z "${HARNESS_PYTHON:-}" ] && command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$@"
  fi
done
for candidate in "${HARNESS_PYTHON:-}" python3; do
  [ -n "$candidate" ] || continue
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null; then
    exec "$candidate" "$@"
  fi
done
echo "monolithic-dev-harness needs Python 3.12 or newer: install it, or set HARNESS_PYTHON to its path." >&2
exit 2
