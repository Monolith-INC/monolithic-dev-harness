{
  "backlog-orchestrator": {
    "command": "sh",
    "args": [
      "${PLUGIN_ROOT}/bin/harness-python",
      "-m",
      "orchestrator_core",
      "mcp"
    ],
    "env": {
      "PYTHONPATH": "${PLUGIN_ROOT}/runtime",
      "ORCHESTRATOR_SKILLS_DIR": "${PLUGIN_ROOT}/skills"
    }
  },
  "workflow-orchestrator": {
    "command": "sh",
    "args": [
      "${PLUGIN_ROOT}/bin/harness-python",
      "${PLUGIN_ROOT}/scripts/orchestrator/run_mcp_server.py"
    ],
    "env": {
      "PYTHONPATH": "${PLUGIN_ROOT}",
      "ORCHESTRATOR_SKILLS_DIR": "${PLUGIN_ROOT}/skills"
    }
  },
  "workflow-integrations": {
    "command": "sh",
    "args": [
      "${PLUGIN_ROOT}/bin/harness-python",
      "${PLUGIN_ROOT}/scripts/integrations/run_gateway.py"
    ],
    "env": {
      "PYTHONPATH": "${PLUGIN_ROOT}"
    }
  }
}
