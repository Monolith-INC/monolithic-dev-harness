{
  "name": "reconcile-feature-stack",
  "version": "1.0.0",
  "description": "Propagate ancestor Feature/Story commits through descendant Story branches in stack order.",
  "input_schema": {
    "type": "object",
    "properties": {
      "feature_id": {
        "type": "string",
        "description": "Feature work-item identifier or name."
      },
      "feature_branch": {
        "type": "string",
        "description": "Optional Feature branch name if already known."
      }
    },
    "required": []
  },
  "output_signature": {
    "type": "object",
    "properties": {
      "feature_branch": {
        "type": "string"
      },
      "reconciled_branches": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "conflicts_resolved": {
        "type": "boolean"
      }
    }
  },
  "tools": []
}
