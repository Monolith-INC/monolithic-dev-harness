{
  "name": "feature-implementation",
  "version": "1.1.0",
  "description": "Start an Active Feature: Phase 0–4 plan plus start-stage stacked Feature/Story branches. Mid-stack sync → reconcile-feature-stack; closeout → finish-feature-development.",
  "input_schema": {
    "type": "object",
    "properties": {
      "feature_id": {
        "type": "string",
        "description": "Feature work-item identifier or name."
      }
    },
    "required": [
      "feature_id"
    ]
  },
  "output_signature": {
    "type": "object",
    "properties": {
      "feature_id": {
        "type": "string"
      },
      "plan_path": {
        "type": "string"
      },
      "feature_branch": {
        "type": "string"
      },
      "mode": {
        "type": "string"
      }
    }
  },
  "tools": []
}
